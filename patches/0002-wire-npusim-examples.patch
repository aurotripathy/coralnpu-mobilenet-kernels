diff --git a/tests/npusim_examples/npusim_run_mobilenet.py b/tests/npusim_examples/npusim_run_mobilenet.py
index 7284e5ad..4d4e96f0 100644
--- a/tests/npusim_examples/npusim_run_mobilenet.py
+++ b/tests/npusim_examples/npusim_run_mobilenet.py
@@ -16,6 +16,40 @@ from bazel_tools.tools.python.runfiles import runfiles
 from coralnpu_v2_sim_utils import CoralNPUV2Simulator
 import numpy as np
 
+EXPECTED_SHAPE = (224, 224, 3)
+
+
+def load_input_from_npy(npy_path):
+    """Loads an image from an .npy file and returns it as flat int8 data.
+
+    The returned array matches the format of the dummy ``input_data`` used by
+    ``run_full_mobilenet`` (a 1-D ``np.int8`` array of length 224*224*3), so it
+    can be written directly into the ``inference_input`` buffer.
+
+    Args:
+        npy_path: Path to a ``.npy`` file holding a 224x224x3 image.
+
+    Returns:
+        A 1-D ``np.int8`` array of length ``224 * 224 * 3``.
+
+    Raises:
+        ValueError: If the array does not have shape (224, 224, 3).
+    """
+    image = np.load(npy_path)
+    if image.shape != EXPECTED_SHAPE:
+        raise ValueError(
+            f"Expected input of shape {EXPECTED_SHAPE}, got {image.shape} "
+            f"from {npy_path}")
+
+    # TFLM MobileNet expects a signed int8 input tensor. If the image is stored
+    # as unsigned [0, 255] pixels, shift into the signed [-128, 127] range;
+    # otherwise assume it is already in the int8 domain.
+    if image.dtype == np.uint8:
+        image = image.astype(np.int16) - 128
+
+    return image.astype(np.int8).reshape(-1)
+
+
 def run_full_mobilenet():
     print(f"Running full mobilenet...")
     npu_sim = CoralNPUV2Simulator(highmem_ld=True, exit_on_ebreak=True)
