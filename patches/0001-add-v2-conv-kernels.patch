+// ============================================================================
+// V2 kernels: rewrites of Conv_3_3_3_8 and Conv_1x1_Pointwise kept under new
+// names so results can be compared against the originals. Differences:
+//   * Read the ORIGINAL filter/bias tensors directly. No DTCM heap copies
+//     (make_aligned_array) and no Prepare-time repacked weight buffers.
+//   * Requantize with tflite::MultiplyByQuantizedMultiplier per element, the
+//     exact TFLM reference path, instead of the vectorized PostprocessAcc
+//     (vsll/vsmul/vssra) pipeline.
+//   * MACs stay vectorized via a widening int8 dot product (vwmacc + vredsum).
+// ============================================================================
+
+// Dot product of two int8 rows with the input zero-point offset applied to
+// `a`: returns sum_i (a[i] + input_offset) * w[i], accumulated in int32.
+inline int32_t DotInt8V2(const int8_t* a, const int8_t* w, int n,
+                         int32_t input_offset) {
+  const size_t vlmax = __riscv_vsetvlmax_e32m4();
+  vint32m4_t acc = __riscv_vmv_v_x_i32m4(0, vlmax);
+  int i = 0;
+  while (i < n) {
+    const size_t vl = __riscv_vsetvl_e8m1(n - i);
+    const vint8m1_t va8 = __riscv_vle8_v_i8m1(&a[i], vl);
+    const vint8m1_t vw8 = __riscv_vle8_v_i8m1(&w[i], vl);
+    // Widen before adding the offset: input_offset can be +128, which does
+    // not fit in the int8 scalar operand of vwadd.vx.
+    const vint16m2_t va16 = __riscv_vadd_vx_i16m2(
+        __riscv_vsext_vf2_i16m2(va8, vl), (int16_t)input_offset, vl);
+    const vint16m2_t vw16 = __riscv_vsext_vf2_i16m2(vw8, vl);
+    acc = __riscv_vwmacc_vv_i32m4(acc, va16, vw16, vl);
+    i += vl;
+  }
+  const vint32m1_t zero = __riscv_vmv_v_x_i32m1(0, 1);
+  const vint32m1_t red = __riscv_vredsum_vs_i32m4_i32m1(acc, zero, vlmax);
+  return __riscv_vmv_x_s_i32m1_i32(red);
+}
+
+// Exact TFLM requantization for one accumulator value.
+inline int8_t RequantizeOneV2(int32_t acc, int32_t bias, int32_t multiplier,
+                              int32_t shift, int32_t output_offset,
+                              int32_t act_min, int32_t act_max) {
+  acc += bias;
+  int32_t out = tflite::MultiplyByQuantizedMultiplier(acc, multiplier, shift);
+  out += output_offset;
+  out = std::max(out, act_min);
+  out = std::min(out, act_max);
+  return static_cast<int8_t>(out);
+}
+
+// V2 of the MobileNet stem kernel (3x3 filter, input_depth 3, output_depth 8).
+// Per output pixel: gather the 27 input taps into a small contiguous buffer
+// (padding slots pre-filled with the input zero point so they contribute 0),
+// then run one vectorized dot product per output channel against the
+// per-channel-contiguous original weights.
+void Conv_3_3_3_8_V2(const ConvParams& params,
+                     const int32_t* output_multiplier,
+                     const int32_t* output_shift,
+                     const RuntimeShape& input_shape, const int8_t* input_data,
+                     const RuntimeShape& filter_shape,
+                     const int8_t* filter_data, const int32_t* bias_data,
+                     const RuntimeShape& output_shape, int8_t* output_data) {
+  const auto batches = MatchingDim(input_shape, 0, output_shape, 0);
+  const int32_t input_offset = params.input_offset;
+  const int32_t output_offset = params.output_offset;
+  const int32_t act_min = params.quantized_activation_min;
+  const int32_t act_max = params.quantized_activation_max;
+  const auto stride_width = params.stride_width;
+  const auto stride_height = params.stride_height;
+  const auto pad_width = params.padding_values.width;
+  const auto pad_height = params.padding_values.height;
+  const auto input_height = input_shape.Dims(1);
+  const auto input_width = input_shape.Dims(2);
+  const auto input_depth = input_shape.Dims(3);
+  const auto output_height = output_shape.Dims(1);
+  const auto output_width = output_shape.Dims(2);
+  const auto output_depth = output_shape.Dims(3);
+  TFLITE_DCHECK_EQ(filter_shape.Dims(1), 3);
+  TFLITE_DCHECK_EQ(filter_shape.Dims(2), 3);
+  TFLITE_DCHECK_EQ(input_depth, 3);
+  TFLITE_DCHECK_EQ(output_depth, 8);
+
+  constexpr int kTaps = 27;  // 3x3x3, contiguous per output channel.
+  const int row_stride = input_width * input_depth;
+  // Padded taps must contribute (pad + input_offset) == 0, so fill with the
+  // input zero point (-input_offset), which always fits in int8.
+  const int8_t pad_value = static_cast<int8_t>(-input_offset);
+
+  for (int batch = 0; batch < batches; ++batch) {
+    const int8_t* batch_base =
+        &input_data[Offset(input_shape, batch, 0, 0, 0)];
+    for (int out_y = 0; out_y < output_height; ++out_y) {
+      const int in_y_origin = (out_y * stride_height) - pad_height;
+      for (int out_x = 0; out_x < output_width; ++out_x) {
+        const int in_x_origin = (out_x * stride_width) - pad_width;
+
+        int8_t taps[kTaps];
+        memset(taps, pad_value, kTaps);
+        for (int ky = 0; ky < 3; ++ky) {
+          const int in_y = in_y_origin + ky;
+          if (in_y < 0 || in_y >= input_height) continue;
+          for (int kx = 0; kx < 3; ++kx) {
+            const int in_x = in_x_origin + kx;
+            if (in_x < 0 || in_x >= input_width) continue;
+            const int8_t* src = batch_base + in_y * row_stride + in_x * 3;
+            int8_t* dst = &taps[(ky * 3 + kx) * 3];
+            dst[0] = src[0];
+            dst[1] = src[1];
+            dst[2] = src[2];
+          }
+        }
+
+        int8_t* out_pix =
+            &output_data[Offset(output_shape, batch, out_y, out_x, 0)];
