+// Kernel for ALL 1x1 pointwise convolutions (filter_height == filter_width == 1).
+// A 1x1 conv is a matrix multiply: out[p][oc] = sum_ic in[p][ic]*W[oc][ic] + b.
+// One parameterized kernel therefore covers every {id,od} fallback shape:
+//   8->16, 16->32, 32->32, ... 128->256, 256->256, 256->5.
+//
+// Strategy:
+//   * Vectorize across OUTPUT channels, tiling od into chunks of `vl`.
+//   * Stream input channels; broadcast each scalar input across the od lanes
+//     with vmacc.vx (no vredsum).
+//   * Fold the input zero-point out of the hot loop via precomputed weight_sums:
+//       acc[oc] = input_offset * weight_sums[oc]  (seed)
+//               + sum_ic in[p][ic] * W[oc][ic]    (streamed)
+//   * Weights are pre-repacked to [ic][od] so each inner fetch is a unit-stride
+//     vle32 that lines up with the od lane tile.
+//
+// Requantization is delegated to PostprocessAcc, identical to the other kernels.
+void Conv_1x1_Pointwise(
+    const ConvParams& params, const OpDataConvCustom& data,
+    const int32_t* output_multiplier, const uint8_t* shift_left,
+    const uint8_t* shift_right, TfLiteContext* context,
+    const RuntimeShape& input_shape, const int8_t* input_data,
+    const RuntimeShape& filter_shape, const int8_t* filter_data,
+    const RuntimeShape& bias_shape, const int32_t* bias_data,
+    const RuntimeShape& output_shape, int8_t* output_data) {
+  const auto batches = MatchingDim(input_shape, 0, output_shape, 0);
+  const int32_t input_offset = params.input_offset;
+  const auto output_offset = params.output_offset;
+  const int32_t output_activation_min = params.quantized_activation_min;
+  const int32_t output_activation_max = params.quantized_activation_max;
+  const auto stride_width = params.stride_width;
+  const auto stride_height = params.stride_height;
+
+  // const auto input_height = input_shape.Dims(1);
+  const auto input_width = input_shape.Dims(2);
+  const auto input_depth = input_shape.Dims(3);      // ID
+  const auto output_height = output_shape.Dims(1);
+  const auto output_width = output_shape.Dims(2);
+  const auto output_depth = output_shape.Dims(3);    // OD
+
+  TFLITE_DCHECK_EQ(filter_shape.Dims(1), 1);
+  TFLITE_DCHECK_EQ(filter_shape.Dims(2), 1);
+
+  // --- Repacked weights [ic][od] and per-oc weight sums, built in Prepare. ---
+  // repacked_weights_generic is reused as int32 [input_depth * output_depth].
+  // Prepare stores the repacked 1x1 weights in a persistent buffer and stashes
+  // the pointer in data.repacked_weights_generic (NOT the scratch arena), so
+  // read it back directly here.
+  const int32_t* W_icod =
+      reinterpret_cast<const int32_t*>(data.repacked_weights_generic);
+  const int32_t* weight_sums = data.weight_sums;  // [output_depth]
+  TFLITE_DCHECK_NE(W_icod, nullptr);
+  TFLITE_DCHECK_NE(weight_sums, nullptr);
+
+  int32_t* accs_buf = static_cast<int32_t*>(
+      context->GetScratchBuffer(context, data.accs_buffer_index));
+  TFLITE_DCHECK_NE(accs_buf, nullptr);
+
+  const int in_row_stride = input_width * input_depth;
+  const int in_col_stride = input_depth;
+
+  for (int batch = 0; batch < batches; ++batch) {
+    const int8_t* batch_base = &input_data[Offset(input_shape, batch, 0, 0, 0)];
+    for (int out_y = 0; out_y < output_height; ++out_y) {
+      const int in_y = out_y * stride_height;  // 1x1 => no pad, stride subsample
+      for (int out_x = 0; out_x < output_width; ++out_x) {
+        const int in_x = out_x * stride_width;
+        const int8_t* in_pix =
+            batch_base + in_y * in_row_stride + in_x * in_col_stride;
+        int32_t* out_acc =
+            &accs_buf[Offset(output_shape, batch, out_y, out_x, 0)];
+
+        // Tile the od axis into vl-sized chunks (up to 32 lanes at e32m8),
+        // broadcasting each scalar input across the od lanes. e32m8 covers 8x
+        // more output channels per instruction than e32m1 (only 4 lanes at
+        // VLEN=128), slashing loop overhead in this overhead-bound kernel.
+        for (int oc0 = 0; oc0 < output_depth;) {
+          const size_t vl = __riscv_vsetvl_e32m8(output_depth - oc0);
+          // Seed the accumulator with the input zero-point term so the streamed
+          // inputs need no per-element offset add:
+          //   sum_ic (in[ic] + off) * W[oc][ic]
+          //     == off * weight_sums[oc] + sum_ic in[ic] * W[oc][ic]
+          vint32m8_t acc = __riscv_vmul_vx_i32m8(
+              __riscv_vle32_v_i32m8(&weight_sums[oc0], vl), input_offset, vl);
+
+          // Stream input channels; broadcast-MAC into the od lanes.
+          for (int ic = 0; ic < input_depth; ++ic) {
+            const int32_t in_val = static_cast<int32_t>(in_pix[ic]);
+            // Row ic of the [ic][od] repacked weights, offset to this od tile.
+            const vint32m8_t w =
+                __riscv_vle32_v_i32m8(&W_icod[ic * output_depth + oc0], vl);
+            acc = __riscv_vmacc_vx_i32m8(acc, in_val, w, vl);
+          }
+
+          __riscv_vse32_v_i32m8(&out_acc[oc0], acc, vl);
+          oc0 += vl;
+        }
+      }
+    }
+  }
+
+  // bias + shift/multiply + output_offset + saturating narrow to int8.
+  PostprocessAcc(accs_buf, bias_data, shift_left, output_multiplier,
+                 shift_right, output_offset, output_activation_min,
+                 output_activation_max, output_data,
+                 batches * output_height * output_width, output_depth);
+}
