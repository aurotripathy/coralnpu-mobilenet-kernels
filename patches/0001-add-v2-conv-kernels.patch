+
+// Kernel for 3x3 filter, input_depth == 3, output_depth == 8 (MobileNet stem).
+// Vectorizes ALONG OUTPUT channels (od == 8) instead of input channels, using
+// vmacc.vx to fan each (input * filter) product across all 8 output lanes.
+void Conv_3_3_3_8(const ConvParams& params, const OpDataConvCustom& data,
+                  const int32_t* output_multiplier, const uint8_t* shift_left,
+                  const uint8_t* shift_right, TfLiteContext* context,
+                  const RuntimeShape& input_shape, const int8_t* input_data,
+                  const RuntimeShape& filter_shape, const int8_t* filter_data,
+                  const RuntimeShape& bias_shape, const int32_t* bias_data,
+                  const RuntimeShape& output_shape, int8_t* output_data) {
+  const auto batches = MatchingDim(input_shape, 0, output_shape, 0);
+  const int32_t input_offset = params.input_offset;  // r = s(q - Z)
+  const auto output_offset = params.output_offset;
+  const int32_t output_activation_min = params.quantized_activation_min;
+  const int32_t output_activation_max = params.quantized_activation_max;
+  const auto stride_width = params.stride_width;
+  const auto stride_height = params.stride_height;
+  const auto pad_width = params.padding_values.width;
+  const auto pad_height = params.padding_values.height;
+  const auto input_height = input_shape.Dims(1);
+  const auto input_width = input_shape.Dims(2);
+  const auto input_depth = input_shape.Dims(3);
+
+  const auto filter_height = filter_shape.Dims(1);
+  const auto filter_width = filter_shape.Dims(2);
+  TFLITE_DCHECK_EQ(filter_height, 3);
+  TFLITE_DCHECK_EQ(filter_width, 3);
+  TFLITE_DCHECK_EQ(input_depth, 3);
+
+  const auto output_height = output_shape.Dims(1);
+  const auto output_width = output_shape.Dims(2);
+  const auto output_depth = output_shape.Dims(3);
+  TFLITE_DCHECK_EQ(output_depth, 8);
+
+  const int row_stride = input_width * input_depth;
+  const int col_stride = input_depth;
+
+  // Pre-gather filter to [tap=ky*kx*kc][out_channel] so each tap is a
+  // unit-stride vle32 that broadcasts across the 8 output lanes.
+  constexpr int kTaps = 3 * 3 * 3;  // 27
+  int32_t* fil_oc = static_cast<int32_t*>(
+      context->GetScratchBuffer(context, data.gathered_weights_index));
+  TFLITE_DCHECK_NE(fil_oc, nullptr);
+
+  const int filter_row_stride = filter_width * input_depth;         // ky step
+  const int filter_col_stride = input_depth;                        // kx step
+  const int filter_oc_stride = filter_height * filter_row_stride;   // oc step
+  for (int tap = 0; tap < kTaps; ++tap) {
+    const int ky = tap / (filter_width * input_depth);
+    const int rem = tap % (filter_width * input_depth);
+    const int kx = rem / input_depth;
+    const int kc = rem % input_depth;
+    for (int oc = 0; oc < output_depth; ++oc) {
+      const int8_t* f = filter_data + oc * filter_oc_stride +
+                        ky * filter_row_stride + kx * filter_col_stride + kc;
+      fil_oc[tap * output_depth + oc] = static_cast<int32_t>(*f);
+    }
+  }
+
+  // tapsum[oc] = sum over all 27 taps of W[oc][tap], stored just past the
+  // gathered weights. Lets the fully-in-bounds case seed the accumulator with
+  // input_offset * tapsum[oc] instead of adding input_offset to all 27 inputs.
+  int32_t* tapsum = fil_oc + kTaps * output_depth;
+  for (int oc = 0; oc < output_depth; ++oc) {
+    int32_t sum = 0;
+    for (int tap = 0; tap < kTaps; ++tap) sum += fil_oc[tap * output_depth + oc];
+    tapsum[oc] = sum;
+  }
+
+  int32_t* accs_buf = static_cast<int32_t*>(
+      context->GetScratchBuffer(context, data.accs_buffer_index));
+  TFLITE_DCHECK_NE(accs_buf, nullptr);
+  Memset(
+      accs_buf, 0,
+      batches * output_height * output_width * output_depth * sizeof(int32_t));
+
+  for (int batch = 0; batch < batches; ++batch) {
+    const int8_t* batch_base_ptr =
+        &input_data[Offset(input_shape, batch, 0, 0, 0)];
+    for (int out_y = 0; out_y < output_height; ++out_y) {
+      const int in_y_origin = (out_y * stride_height) - pad_height;
+      for (int out_x = 0; out_x < output_width; ++out_x) {
+        const int in_x_origin = (out_x * stride_width) - pad_width;
+        int32_t* out_acc =
+            &accs_buf[Offset(output_shape, batch, out_y, out_x, 0)];
+
+        // Tile the output-channel axis. e32m2 holds 8 int32 lanes at VLEN=128,
+        // which covers this kernel's 8 output channels in a single tile (e32m1
+        // fits only 4, forcing two passes over the 27 taps). The loop is kept
+        // for generality rather than assuming one vector always fits.
+        // Whether the whole 3x3 window is in bounds. When it is, every tap
+        // contributes and no bounds check can fire, so the zero-point term
+        // collapses to the constant input_offset * tapsum[oc].
+        const bool interior = in_y_origin >= 0 &&
+                              in_y_origin + 2 < input_height &&
+                              in_x_origin >= 0 && in_x_origin + 2 < input_width;
+
+        for (int oc0 = 0; oc0 < output_depth;) {
+          const size_t vl = __riscv_vsetvl_e32m2(output_depth - oc0);
+          vint32m2_t acc;
+
+          if (interior) {
+            acc = __riscv_vmul_vx_i32m2(
+                __riscv_vle32_v_i32m2(&tapsum[oc0], vl), input_offset, vl);
+            const int8_t* win =
+                batch_base_ptr + in_y_origin * row_stride +
+                in_x_origin * col_stride;
+            for (int ky = 0; ky < 3; ++ky) {
+              for (int kx = 0; kx < 3; ++kx) {
+                const int8_t* in_pix = win + ky * row_stride + kx * col_stride;
+                for (int kc = 0; kc < 3; ++kc) {
+                  const int tap = ky * (filter_width * input_depth) +
+                                  kx * input_depth + kc;
+                  const vint32m2_t fil_vec = __riscv_vle32_v_i32m2(
+                      &fil_oc[tap * output_depth + oc0], vl);
+                  acc = __riscv_vmacc_vx_i32m2(
+                      acc, static_cast<int32_t>(in_pix[kc]), fil_vec, vl);
+                }
+              }
+            }
+          } else {
+            acc = __riscv_vmv_v_x_i32m2(0, vl);
+            for (int ky = 0; ky < 3; ++ky) {
+              const int in_y = in_y_origin + ky;
+              if (in_y < 0 || in_y >= input_height) continue;
+              for (int kx = 0; kx < 3; ++kx) {
+                const int in_x = in_x_origin + kx;
+                if (in_x < 0 || in_x >= input_width) continue;
+                const int8_t* in_pix =
+                    batch_base_ptr + in_y * row_stride + in_x * col_stride;
+                for (int kc = 0; kc < 3; ++kc) {
+                  const int32_t in_val =
+                      static_cast<int32_t>(in_pix[kc]) + input_offset;
+                  const int tap = ky * (filter_width * input_depth) +
+                                  kx * input_depth + kc;
+                  const vint32m2_t fil_vec = __riscv_vle32_v_i32m2(
+                      &fil_oc[tap * output_depth + oc0], vl);
+                  acc = __riscv_vmacc_vx_i32m2(acc, in_val, fil_vec, vl);
+                }
+              }
+            }
+          }
+
+          __riscv_vse32_v_i32m2(&out_acc[oc0], acc, vl);
+          oc0 += vl;
+        }
+      }
+    }
+  }
+
+  PostprocessAcc(accs_buf, bias_data, shift_left, output_multiplier,
+                 shift_right, output_offset, output_activation_min,
+                 output_activation_max, output_data,
+                 batches * output_height * output_width, output_depth);
+}
