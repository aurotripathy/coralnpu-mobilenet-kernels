+            batch_base + in_y * in_row_stride + in_x * input_depth;
+        int8_t* out_pix =
+            &output_data[Offset(output_shape, batch, out_y, out_x, 0)];
+        for (int oc = 0; oc < output_depth; ++oc) {
+          const int32_t acc = DotInt8V2(
+              in_pix, &filter_data[oc * input_depth], input_depth,
+              input_offset);
+          out_pix[oc] =
+              RequantizeOneV2(acc, bias_data ? bias_data[oc] : 0,
+                              output_multiplier[oc], output_shift[oc],
+                              output_offset, act_min, act_max);
+        }
+      }
+    }
+  }
+}
